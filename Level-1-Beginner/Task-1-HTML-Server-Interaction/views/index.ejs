<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CampusSphere | Your Campus, Connected</title>

    <!-- Prevent theme flash -->
    <script>
        (() => {
            const storedTheme =
                localStorage.getItem("campusSphereTheme");

            const prefersDark =
                window.matchMedia(
                    "(prefers-color-scheme: dark)"
                ).matches;

            const initialTheme =
                storedTheme === "dark" ||
                    (storedTheme === "system" && prefersDark)
                    ? "dark"
                    : "light";

            document.documentElement.setAttribute(
                "data-theme",
                initialTheme
            );
        })();
    </script>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <!-- =========================================
         NAVIGATION
         ========================================= -->

    <header class="navbar">

        <a href="/" class="brand">
            CampusSphere
        </a>


        <nav class="nav-links">

            <a href="#features">
                Features
            </a>

            <a href="#registration">
                Registration
            </a>

            <a href="#about">
                About
            </a>

        </nav>


        <!-- Theme Selector -->

        <div class="theme-selector">

            <button type="button" class="theme-button" id="themeButton">

                <span id="themeIcon">◌</span>

                <span>Theme</span>

            </button>


            <div class="theme-menu" id="themeMenu">

                <button type="button" class="theme-option" data-theme="light">
                    <span>☀</span>
                    Light
                </button>


                <button type="button" class="theme-option" data-theme="dark">
                    <span>◐</span>
                    Dark
                </button>


                <button type="button" class="theme-option" data-theme="system">
                    <span>◌</span>
                    System
                </button>

            </div>

        </div>

    </header>



    <!-- =========================================
         HERO SECTION
         ========================================= -->

    <main>

        <section class="hero-section">

            <div class="hero-content">

                <p class="eyebrow">
                    CAMPUS MANAGEMENT PLATFORM
                </p>

                <h1>
                    Your campus,
                    <span>connected.</span>
                </h1>

                <p class="hero-description">
                    CampusSphere brings student profiles, campus
                    activities, opportunities and everyday
                    student interactions into one connected space.
                </p>


                <div class="hero-actions">

                    <a href="#registration" class="primary-action">
                        Register Your Profile
                    </a>

                    <a href="#features" class="secondary-action">
                        Explore Platform
                    </a>

                </div>

            </div>


            <!-- Platform Preview -->

            <div class="hero-preview">

                <div class="preview-window">

                    <div class="preview-topbar">

                        <span></span>
                        <span></span>
                        <span></span>

                    </div>


                    <div class="preview-content">

                        <div class="preview-heading">

                            <div>

                                <p>
                                    CAMPUS OVERVIEW
                                </p>

                                <h2>
                                    Student Activity
                                </h2>

                            </div>

                            <span class="preview-status">
                                Live
                            </span>

                        </div>


                        <!-- Activity visualization -->

                        <div class="activity-chart">

                            <svg class="activity-graph" viewBox="0 0 500 180" preserveAspectRatio="none" aria-label="Student activity overview">

                                <!-- Grid -->
                                <line x1="0" y1="45" x2="500" y2="45"></line>
                                <line x1="0" y1="90" x2="500" y2="90"></line>
                                <line x1="0" y1="135" x2="500" y2="135"></line>

                                <!-- Area -->
                                <path class="graph-area" d="
                                        M 0 135
                                        L 70 118
                                        L 140 125
                                        L 210 82
                                        L 280 98
                                        L 350 55
                                        L 420 72
                                        L 500 28
                                        L 500 180
                                        L 0 180
                                        Z
                                    "></path>

                                <!-- Main Line -->
                                <path class="graph-path" d="
                                        M 0 135
                                        L 70 118
                                        L 140 125
                                        L 210 82
                                        L 280 98
                                        L 350 55
                                        L 420 72
                                        L 500 28
                                    "></path>

                                <!-- Data Points -->
                                <circle cx="70" cy="118" r="4"></circle>
                                <circle cx="140" cy="125" r="4"></circle>
                                <circle cx="210" cy="82" r="4"></circle>
                                <circle cx="280" cy="98" r="4"></circle>
                                <circle cx="350" cy="55" r="4"></circle>
                                <circle cx="420" cy="72" r="4"></circle>
                                <circle cx="500" cy="28" r="4"></circle>

                            </svg>

                        </div>


                        <div class="preview-modules">

                            <div class="preview-module">

                                <span>
                                    Profiles
                                </span>

                                <strong>
                                    Student
                                </strong>

                            </div>


                            <div class="preview-module">

                                <span>
                                    Events
                                </span>

                                <strong>
                                    Campus
                                </strong>

                            </div>


                            <div class="preview-module">

                                <span>
                                    Opportunities
                                </span>

                                <strong>
                                    Career
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================================
             PLATFORM OVERVIEW
             ========================================= -->

        <section class="overview-section">

            <div class="section-heading">

                <p class="eyebrow">
                    PLATFORM OVERVIEW
                </p>

                <h2>
                    One space for everyday campus life.
                </h2>

                <p>
                    CampusSphere is designed to bring the
                    essential parts of student life together
                    through a single digital platform.
                </p>

            </div>


            <div class="overview-grid">

                <div class="overview-panel overview-large">

                    <div class="panel-label">
                        STUDENT EXPERIENCE
                    </div>

                    <h3>
                        Stay connected with your campus.
                    </h3>

                    <p>
                        Keep important student information,
                        campus activities and opportunities
                        accessible from one place.
                    </p>


                    <div class="experience-list">

                        <div>
                            <span>01</span>
                            Student Profile
                        </div>

                        <div>
                            <span>02</span>
                            Campus Events
                        </div>

                        <div>
                            <span>03</span>
                            Opportunities
                        </div>

                        <div>
                            <span>04</span>
                            Productivity
                        </div>

                    </div>

                </div>


                <div class="overview-panel dashboard-panel">

                    <div class="panel-label">
                        CAMPUS MODULES
                    </div>

                    <div class="module-stack">

                        <div class="module-row">

                            <span>
                                Student Profiles
                            </span>

                            <span class="module-dot"></span>

                        </div>


                        <div class="module-row">

                            <span>
                                Events & Activities
                            </span>

                            <span class="module-dot"></span>

                        </div>


                        <div class="module-row">

                            <span>
                                Opportunities
                            </span>

                            <span class="module-dot"></span>

                        </div>


                        <div class="module-row">

                            <span>
                                Academic Resources
                            </span>

                            <span class="module-dot"></span>

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================================
             FEATURES
             ========================================= -->

        <section class="features-section" id="features">

            <div class="section-heading">

                <p class="eyebrow">
                    FEATURES
                </p>

                <h2>
                    Built around the student experience.
                </h2>

                <p>
                    A modular foundation that can grow with
                    the needs of students and campus communities.
                </p>

            </div>


            <div class="features-grid">

                <article class="feature-card">

                    <span class="feature-number">
                        01
                    </span>

                    <h3>
                        Student Profiles
                    </h3>

                    <p>
                        Maintain a centralized student profile
                        containing essential academic and
                        personal information.
                    </p>

                </article>


                <article class="feature-card">

                    <span class="feature-number">
                        02
                    </span>

                    <h3>
                        Events & Activities
                    </h3>

                    <p>
                        Discover campus events, activities and
                        student initiatives from a connected space.
                    </p>

                </article>


                <article class="feature-card">

                    <span class="feature-number">
                        03
                    </span>

                    <h3>
                        Opportunities
                    </h3>

                    <p>
                        Keep track of internships, competitions,
                        workshops and other student opportunities.
                    </p>

                </article>


                <article class="feature-card">

                    <span class="feature-number">
                        04
                    </span>

                    <h3>
                        Productivity
                    </h3>

                    <p>
                        Organize everyday academic activities,
                        tasks and useful campus resources.
                    </p>

                </article>


                <article class="feature-card">

                    <span class="feature-number">
                        05
                    </span>

                    <h3>
                        Campus Updates
                    </h3>

                    <p>
                        Provide a structured place for important
                        announcements and campus information.
                    </p>

                </article>


                <article class="feature-card">

                    <span class="feature-number">
                        06
                    </span>

                    <h3>
                        Connected Platform
                    </h3>

                    <p>
                        Bring multiple campus interactions
                        together through one scalable platform.
                    </p>

                </article>

            </div>

        </section>



        <!-- =========================================
             REGISTRATION
             ========================================= -->

        <section class="registration-section" id="registration">

            <div class="registration-intro">

                <p class="eyebrow">
                    GET STARTED
                </p>

                <h2>
                    Create your student profile.
                </h2>

                <p>
                    Register your basic student information
                    to get started with CampusSphere.
                </p>

            </div>


            <div class="registration-card">

                <!-- Mac-style window header -->
                <div class="card-windowbar">

                    <span></span>
                    <span></span>
                    <span></span>

                </div>


                <div class="card-header">

                    <p class="eyebrow">
                        STUDENT REGISTRATION
                    </p>

                    <h2>
                        Registration details
                    </h2>

                    <p class="subtitle">
                        Enter your information below.
                    </p>

                </div>


                <form action="/register" method="POST" class="registration-form">

                    <div class="form-grid">

                        <!-- Full Name -->

                        <div class="form-group">

                            <label for="fullName">
                                Full Name
                            </label>

                            <input type="text" id="fullName" name="fullName" placeholder="Enter your full name"
                                required>

                        </div>


                        <!-- Email -->

                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input type="email" id="email" name="email" placeholder="Enter your email" required>

                        </div>


                        <!-- Phone -->

                        <div class="form-group">

                            <label for="phone">
                                Phone Number
                            </label>

                            <input type="tel" id="phone" name="phone" placeholder="Enter your phone number" required>

                        </div>


                        <!-- Department -->

                        <div class="form-group">

                            <label for="department">
                                Department
                            </label>

                            <select id="department" name="department" required>

                                <option value="">
                                    Select department
                                </option>

                                <option value="Computer Science & Engineering">
                                    Computer Science & Engineering
                                </option>

                                <option value="Information Technology">
                                    Information Technology
                                </option>

                                <option value="Electronics & Communication Engineering">
                                    Electronics & Communication Engineering
                                </option>

                                <option value="Electrical Engineering">
                                    Electrical Engineering
                                </option>

                                <option value="Mechanical Engineering">
                                    Mechanical Engineering
                                </option>

                                <option value="Civil Engineering">
                                    Civil Engineering
                                </option>

                            </select>

                        </div>


                        <!-- Academic Year -->

                        <div class="form-group full-width">

                            <label for="year">
                                Academic Year
                            </label>

                            <select id="year" name="year" required>

                                <option value="">
                                    Select academic year
                                </option>

                                <option value="1st Year">
                                    1st Year
                                </option>

                                <option value="2nd Year">
                                    2nd Year
                                </option>

                                <option value="3rd Year">
                                    3rd Year
                                </option>

                                <option value="4th Year">
                                    4th Year
                                </option>

                            </select>

                        </div>

                    </div>


                    <button type="submit" class="submit-btn">
                        Register Student
                    </button>

                </form>

            </div>

        </section>



        <!-- =========================================
             ABOUT
             ========================================= -->

        <section class="about-section" id="about">

            <div class="about-content">

                <p class="eyebrow">
                    ABOUT CAMPUSSPHERE
                </p>

                <h2>
                    Designed as a connected campus
                    experience.
                </h2>

                <p>
                    CampusSphere is a full-stack student and
                    campus management platform designed to
                    bring commonly used campus services into
                    one organized digital environment.
                </p>

                <p>
                    The platform is being developed progressively,
                    starting with student registration and
                    server-side interactions and expanding toward
                    authentication, databases, APIs and other
                    full-stack capabilities.
                </p>

            </div>


            <div class="about-stats">

                <div class="about-stat">

                    <strong>
                        01
                    </strong>

                    <span>
                        Student-first
                    </span>

                </div>


                <div class="about-stat">

                    <strong>
                        02
                    </strong>

                    <span>
                        Modular
                    </span>

                </div>


                <div class="about-stat">

                    <strong>
                        03
                    </strong>

                    <span>
                        Scalable
                    </span>

                </div>

            </div>

        </section>

    </main>



    <!-- =========================================
         FOOTER
         ========================================= -->

    <footer class="site-footer">

        <div class="footer-inner">

            <div class="footer-main">

                <div class="footer-brand">

                    <a href="/" class="footer-logo">
                        CampusSphere
                    </a>

                    <p class="footer-description">
                        A connected space for campus life,
                        opportunities, and student activities.
                    </p>

                </div>


                <div class="footer-column">

                    <h3>
                        Platform
                    </h3>

                    <a href="#features">
                        Features
                    </a>

                    <a href="#registration">
                        Registration
                    </a>

                    <a href="#about">
                        About
                    </a>

                </div>


                <div class="footer-column">

                    <h3>
                        Support
                    </h3>

                    <a href="#">
                        Help Center
                    </a>

                    <a href="mailto:support@campussphere.local">
                        Contact
                    </a>

                    <a href="#">
                        Privacy
                    </a>

                </div>

            </div>


            <div class="footer-divider"></div>


            <div class="footer-bottom">

                <p>
                    © 2026 CampusSphere. All rights reserved.
                </p>

                <p>
                    Full Stack Development Project
                </p>

            </div>

        </div>

    </footer>



    <!-- Theme JavaScript -->

    <script src="/js/theme.js"></script>

</body>

</html>
